# Garmin credentials are only needed once, for the initial `garmin-mcp auth login`.
# After tokens are persisted, the server runs without these — do not leave them
# filled in long-term.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=
# If set, used non-interactively as the MFA code during `auth login`.
GARMIN_MFA=

# Where OAuth tokens are read/written. Kept inside the project (gitignored)
# so this isn't tied to a particular machine's home directory.
GARMIN_TOKENS_PATH=./.garmin-tokens

# Transport for the MCP server: "stdio" (default, used by Claude Code) or "http".
MCP_TRANSPORT=stdio
